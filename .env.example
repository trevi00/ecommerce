# E-commerce Application Environment Variables
# Copy this file to .env and customize for your environment

# ====================
# Application Settings
# ====================
APP_PORT=8080
SPRING_PROFILES_ACTIVE=docker
APP_LOG_LEVEL=DEBUG
LOG_LEVEL=INFO

# ====================
# Database Configuration
# ====================
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=your_secure_db_password_here
MYSQL_PORT=3306

# Initialize test data (true/false)
MYSQL_INIT_TEST_DATA=true

# ====================
# Redis Configuration
# ====================
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_COMMANDER_PORT=8082

# ====================
# Security Configuration
# ====================
JWT_SECRET=your-very-secure-jwt-secret-key-here-minimum-32-characters
JWT_EXPIRATION=86400000

# Payment token validity (minutes)
PAYMENT_TOKEN_VALIDITY=30

# ====================
# Monitoring Configuration
# ====================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password_change_me

# ====================
# Development Tools
# ====================
PHPMYADMIN_PORT=8081

# ====================
# External APIs (if needed)
# ====================
# Payment Gateway API Keys
TOSS_CLIENT_KEY=your_toss_client_key
TOSS_SECRET_KEY=your_toss_secret_key
KAKAO_PAY_CID=your_kakao_pay_cid
KAKAO_PAY_SECRET=your_kakao_pay_secret

# Email Service
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password

# File Storage (AWS S3 or compatible)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your-ecommerce-bucket

# ====================
# Performance Tuning
# ====================
# JVM Settings
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# Connection Pool Settings
HIKARI_MAXIMUM_POOL_SIZE=20
HIKARI_MINIMUM_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000

# ====================
# Feature Flags
# ====================
FEATURE_PAYMENT_ENABLED=true
FEATURE_COUPON_ENABLED=true
FEATURE_NOTIFICATION_ENABLED=false
FEATURE_RECOMMENDATION_ENABLED=false

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ====================
# Cache Settings
# ====================
CACHE_TTL_PRODUCTS=3600
CACHE_TTL_USERS=1800
CACHE_TTL_ORDERS=900